# scrapariga — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ────────────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Runtime environment: development | production
NODE_ENV=development

# ─── Browser / TLS ───────────────────────────────────────────────────────────
# Accept invalid TLS certificates. Required when a corporate TLS-inspection
# proxy (e.g. FortiGate MITM) re-signs HTTPS with a CA Chromium does not trust —
# otherwise every page.goto fails with net::ERR_CERT_AUTHORITY_INVALID.
# Set to false to enforce strict certificate validation.
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=true

# Extra CA certificate (PEM) trusted by Node/axios file downloads, in addition
# to Node's defaults and the OS CA bundle. Only needed if a corporate CA is not
# already installed in the system trust store.
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem

# ─── DemoProvider ────────────────────────────────────────────────────────────
# Set to a step name to simulate failure on that step (for testing the retry UI).
# Accepted values: login | fetch | download
# Leave blank (or omit) for normal demo execution.
DEMO_FAIL_ON=

# ─── Zeev (Nota Fiscal ▸ Submeter Zeev) ──────────────────────────────────────
# SSO Microsoft da Sipal.
SIPAL_MICROSOFT_EMAIL=
SIPAL_MICROSOFT_PASSWORD=
# Gestor aprovador selecionado no formulário (nome exato da opção).
SIPAL_GESTOR_APROVADOR=
# URL do formulário de request do Zeev (contém o token c=...). Obrigatória —
# não há default no código (o repositório é público).
SIPAL_ZEEV_URL=
# Força o navegador headless (default: headful, para concluir MFA na 1ª vez).
ZEEV_HEADLESS=false

# ─── Future Provider Credentials ─────────────────────────────────────────────
# Provider-specific variables will be added here automatically
# when you run each provider for the first time and answer the credential prompts.
# Example:
# ENEL_USERNAME=
# ENEL_PASSWORD=
